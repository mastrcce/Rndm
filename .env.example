# PostgreSQL mit PostGIS (lokal oder Supabase: Settings -> Database -> Connection string, "Transaction pooler")
DATABASE_URL=postgres://postgres@127.0.0.1:5432/rohmilch
# Bei Supabase/gehosteten Datenbanken: SSL aktivieren
DATABASE_SSL=false

# Öffentliche Basis-URL (für Sitemap, Canonical-URLs, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin-Zugang (Passwort und ein langer zufälliger Schlüssel zum Signieren der Sitzung)
ADMIN_PASSWORD=bitte-aendern
ADMIN_SESSION_SECRET=bitte-durch-mindestens-32-zufaellige-zeichen-ersetzen

# Kartenkacheln. Standard: OpenStreetMap. Für viel Traffic eigenen Anbieter verwenden
# (OSM Tile Usage Policy beachten).
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>-Mitwirkende'

# Geocoding-Fallback (Nominatim). Leer lassen = nur lokale Ortsdatenbank.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="rohmilch-atlas/0.1 (kontakt@example.org)"

# Overpass-API für den Live-Import aus OpenStreetMap
OVERPASS_URL=https://overpass-api.de/api/interpreter
